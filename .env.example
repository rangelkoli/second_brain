# PocketBase sync server. Web builds served by PocketBase itself can leave this empty (same origin);
# the desktop app needs it, and syncing is off without it. Use https for a remote server.
VITE_PB_URL=http://127.0.0.1:8090

# Gemini key for the trainer, read by the PocketBase hook (pocketbase/pb_hooks/gemini.pb.js) from the server's
# environment. No VITE_ prefix, so it never reaches the browser bundle. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
