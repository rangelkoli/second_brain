{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [
        {
          "path": "$HOME/SecondBrain/**"
        },
        {
          "path": "$HOME/Library/CloudStorage/**"
        }
      ]
    },
    "opener:default",
    "fs:allow-read-dir",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-write-file",
    "fs:allow-mkdir",
    "fs:allow-rename",
    "fs:allow-remove",
    "fs:allow-exists",
    "fs:allow-stat",
    "fs:allow-watch",
    "fs:allow-unwatch",
    {
      "identifier": "fs:scope",
      "allow": [
        {
          "path": "$HOME/SecondBrain"
        },
        {
          "path": "$HOME/SecondBrain/**"
        },
        {
          "path": "$HOME/Library/CloudStorage"
        },
        {
          "path": "$HOME/Library/CloudStorage/**"
        }
      ]
    }
  ]
}
